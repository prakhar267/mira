# Copy to a local ignored secret file for development only.
# Never commit real values. Values prefixed NEXT_PUBLIC_ are exposed to browsers.

# Public application configuration
APP_ENV=development
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_AI_MOCK_MODE=true
PUBLIC_SUPPORT_URL=
PUBLIC_PRIVACY_URL=
PUBLIC_TERMS_URL=

# Cloudflare deployment metadata (CI uses GitHub secrets instead)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_WORKER_NAME=saathkind
KV_NAMESPACE_ID=
ADMIN_API_KEY=local-admin-key-change-me

# Server-side application secrets
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://companion:companion_local_only@localhost:5432/companion
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=companion-local
S3_ACCESS_KEY_ID=companion
S3_SECRET_ACCESS_KEY=companion_local_only

# Provider selection and mock runtime
AI_MOCK_MODE=true
CHAT_PROVIDER=mock
EMBEDDING_PROVIDER=mock
MODERATION_PROVIDER=local
STT_PROVIDER=mock
TTS_PROVIDER=mock
REALTIME_VOICE_PROVIDER=mock
VISION_PROVIDER=mock
IMAGE_GENERATION_PROVIDER=mock
CHAT_MODEL=mock-companion-v1
EMBEDDING_MODEL=mock-embedding-v1

# Gemini is deliberately disabled in the synthetic beta. Enabling it is a
# separately reviewed processor, consent, safety, deletion, and budget change.
ENABLE_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Future providers are not wired into the current release.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_SECRET=

# Observability (configure a provider before public launch)
ERROR_REPORTING_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
ALERT_WEBHOOK_URL=

# Future release flags. They have no effect until their implementation and
# deployment contracts are reviewed and wired server-side.
FEATURE_BILLING=true
FEATURE_VOICE=true
FEATURE_LIVE_AUDIO=true
FEATURE_LIVE_VIDEO=true
FEATURE_MOOD_INFERENCE=false
FEATURE_CAMERA=true
FEATURE_IMAGE_GENERATION=true
FEATURE_ROMANTIC_MODE=true
FEATURE_PROACTIVE_MESSAGING=true
FEATURE_ADVANCED_MEMORY=true
FEATURE_STORE=true
FEATURE_JOURNAL=true
