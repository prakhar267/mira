# Copy to a local ignored secret file for development only.
# Never commit real values. Never expose secrets through a VITE_ variable.

# Public application configuration
APP_ENV=development
APP_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_SUPPORT_URL=
PUBLIC_PRIVACY_URL=
PUBLIC_TERMS_URL=

# Cloudflare deployment metadata (CI uses GitHub secrets instead)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_WORKER_NAME=saathkind
KV_NAMESPACE_ID=
ADMIN_API_KEY=

# Server-side application secrets
SESSION_SECRET=

# Gemini is deliberately disabled in the synthetic beta. Enabling it is a
# separately reviewed processor, consent, safety, deletion, and budget change.
ENABLE_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Future providers are not wired into the current release.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Observability (configure a provider before public launch)
ERROR_REPORTING_DSN=
LOG_LEVEL=info
ALERT_WEBHOOK_URL=

# Future release flags. They have no effect until their implementation and
# deployment contracts are reviewed and wired server-side.
FEATURE_BILLING=false
FEATURE_VOICE=false
FEATURE_LIVE_AUDIO=false
FEATURE_LIVE_VIDEO=false
FEATURE_MOOD_INFERENCE=false
