# ACTIVE apps/web Cloudflare configuration reference, not a secret file.
# The isolated synthetic setup needs NONE of these values:
# pnpm --filter @companion/web dev:synthetic
# Optional Fastify variables are documented separately in .env.fastify.example.
# Production bindings/resource IDs are in apps/web/wrangler.jsonc; do not rename.
# Set deployed secrets using approved Cloudflare secret tooling, not NEXT_PUBLIC_.
SITE_ORIGIN=https://luma-companion.prakhargupta267.workers.dev
NEXT_PUBLIC_SITE_URL=https://luma-companion.prakhargupta267.workers.dev
INWORLD_API_KEY=
MIRA_ADMIN_KEY=
MIRA_SUPPORT_OWNER=
MIRA_ALERT_WEBHOOK=
CHAT_DAILY_LIMIT=600
TRANSCRIBE_DAILY_LIMIT=600
SPEECH_DAILY_LIMIT=600
MIRA_BETA_ACCOUNT_LIMIT=250
# Optional server-side emergency pause; local compiled test helpers force true.
MIRA_INFERENCE_DISABLED=false

# Optional mail; missing/invalid config fails honestly, no "sent" claim.
# Sender verification and actual mailbox tests require owner authorization.
RESEND_API_KEY=
EMAIL_FROM=

# Dormant independent suppression adapter. NOT an activation flag.
# No service or production enrollment is provisioned; see docs/SUPPRESSION-AUTHORITY.md.
# Complete bootstrap + serving/recovery fencing must precede any activation.
MIRA_SUPPRESSION_AUTHORITY_URL=
MIRA_SUPPRESSION_AUTHORITY_ID=
MIRA_SUPPRESSION_AUTHORITY_TOKEN=

# Payments deliberately excluded and disabled; do not activate in this task.
BILLING_ENABLED=false
DODO_PAYMENTS_ENVIRONMENT=test_mode

# CI/deployment authorization only; never client-visible.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
