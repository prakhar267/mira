{
  "name": "@companion/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build --webpack",
    "start": "next start -p 3001",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.mjs",
    "test:browser": "playwright test --config playwright.config.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "assets:marketing": "node scripts/optimize-marketing-assets.mjs",
    "assets:check": "node scripts/optimize-marketing-assets.mjs --check",
    "dev:vinext": "vinext dev --port 3001",
    "dev:synthetic": "MIRA_SYNTHETIC=1 CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vinext dev --host 127.0.0.1 --port 4397 --strictPort",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@companion/ai": "workspace:*",
    "@companion/config": "workspace:*",
    "@companion/shared": "workspace:*",
    "@companion/ui": "workspace:*",
    "@fontsource/cormorant-garamond": "5.2.8",
    "@fontsource/manrope": "5.2.7",
    "@phosphor-icons/react": "^2.1.10",
    "@pixiv/three-vrm": "3.5.3",
    "@vinext/cloudflare": "1.0.0-beta.6",
    "dodopayments": "^2.50.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "three": "0.185.1",
    "vinext": "1.0.0-beta.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/vitest-plugin": "^1.1.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.23",
    "sharp": "0.35.4",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "4.1.11",
    "wrangler": "^4.127.1"
  },
  "type": "module"
}
