{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luma-companion",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "LUMA_ACCOUNTS",
      "id": "8e9c00cb8b39465aa02b07e1fc9e47ec"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
