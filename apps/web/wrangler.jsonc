{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luma-companion",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": { "SITE_ORIGIN": "https://luma-companion.prakhargupta267.workers.dev", "BILLING_ENABLED": "false", "DODO_PAYMENTS_ENVIRONMENT": "test_mode" },
  "durable_objects": { "bindings": [{ "name": "MIRA_STORE", "class_name": "MiraStore" }, { "name": "MIRA_RECOVERY_TEST", "class_name": "MiraRecoveryDrill" }] },
  "migrations": [{ "tag": "mira-store-v1", "new_sqlite_classes": ["MiraStore"] }, { "tag": "mira-recovery-drill-v1", "new_sqlite_classes": ["MiraRecoveryDrill"] }],
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "LUMA_ACCOUNTS",
      "id": "8e9c00cb8b39465aa02b07e1fc9e47ec"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
