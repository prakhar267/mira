{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mira-synthetic-tests",
  "main": "tests/worker/router.mjs",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "SITE_ORIGIN": "http://localhost:4173",
    "MIRA_LOCAL_TEST": "synthetic-only",
    "BILLING_ENABLED": "false",
    "INWORLD_API_KEY": "synthetic-not-a-secret",
    "CHAT_DAILY_LIMIT": "600",
    "SPEECH_DAILY_LIMIT": "600",
    "TRANSCRIBE_DAILY_LIMIT": "600"
  },
  "durable_objects": {"bindings": [{"name":"MIRA_STORE","class_name":"MiraStore"},{"name":"MIRA_AUTHORITY","class_name":"SyntheticRecoveryAuthority"}]},
  "migrations": [{"tag":"synthetic-store-v1","new_sqlite_classes":["MiraStore","SyntheticRecoveryAuthority"]}],
  "kv_namespaces": [{"binding":"LUMA_ACCOUNTS","id":"00000000000000000000000000000000"}],
  "services": [
    {"binding":"AI","service":"mira-synthetic-tests","entrypoint":"MockAI"},
    {"binding":"MIRA_TEST_PROVIDERS","service":"mira-synthetic-tests","entrypoint":"MockProviders"}
  ]
}
